  "model_policy": {
    "allowed_models": [
      "Linear Regression",
      "Random Forest",
      "Gradient Boosting"
    ],

    "selection_metric": "MAE",
    "lower_is_better": true,

    "validation": {
      "required": true,
      "test_size": 0.20,
      "minimum_training_samples": 10,
      "metrics": [
        "MAE",
        "RMSE",
        "R2"
      ]
    },

    "prediction_quality": {
      "minimum_acceptable_r2": 0.00,
      "maximum_acceptable_mae_ratio": 0.20,
      "low_quality_requires_review": true
    },

    "save_selected_model": true,
    "model_directory": "models"
  },

  "anomaly_policy": {
    "global_method": "ISOLATION_FOREST_PLUS_Z_SCORE",
    "lot_aware": true,
    "lot_group_columns": [
      "Lot_ID",
      "Component_Type"
    ],
    "minimum_lot_size": 5,
    "z_score_threshold": 3.0
  },

  "decision_policy": {
    "supported_directions": [
      "HIGH",
      "LOW",
      "BOTH",
      "UNKNOWN"
    ],

    "unknown_direction_requires_review": true,

    "decision_levels": [
      "PASS",
      "INVESTIGATE",
      "REJECT",
      "REVIEW"
    ],

    "engineering_override": true
