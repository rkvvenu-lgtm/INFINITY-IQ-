  "decision_policy": {
    "supported_directions": [
      "HIGH",
      "LOW",
      "BOTH",
      "UNKNOWN"
    ],

    "high_direction": {
      "warning_when": "VALUE_ABOVE_WARNING",
      "reject_when": "VALUE_ABOVE_MAXIMUM"
    },

    "low_direction": {
      "warning_when": "VALUE_BELOW_WARNING",
      "reject_when": "VALUE_BELOW_MINIMUM"
    },

    "both_direction": {
      "warning_when": "VALUE_OUTSIDE_WARNING_RANGE",
      "reject_when": "VALUE_OUTSIDE_ALLOWED_RANGE"
    },

    "unknown_direction": {
      "action": "REVIEW",
      "allow_automatic_rejection": false
    }
